# Copy to /etc/komari-mainland-probe.env (chmod 640 root:root)
PROBE_LOCATION=China Mainland
# Optional: set to physical NIC (e.g. eth0 / enp4s0) to bypass local TUN proxy
PROBE_INTERFACE=eth0
PROBE_LISTEN=127.0.0.1:25775
PROBE_INTERVAL=60
PROBE_TIMEOUT=3
# Optional: also write static JSON file (requires ReadWritePaths= in unit if set)
# PROBE_OUT_FILE=/var/lib/komari-mainland-probe/mainland-status.json
PROBE_TARGETS=[{"name":"US-Node-1","ip":"203.0.113.10","port":443},{"name":"US-Node-2","ip":"198.51.100.20","port":443}]
